#include <stdio.h>

#define V 5
#define E 7

struct Edge
{
    int source, destination, weight;
};

int parent[V];

int find(int i)
{
    while (parent[i] != i)
        i = parent[i];

    return i;
}

void unionSet(int i, int j)
{
    int a = find(i);
    int b = find(j);

    parent[a] = b;
}

void sortEdges(struct Edge edges[])
{
    int i, j;
    struct Edge temp;

    for (i = 0; i < E - 1; i++)
    {
        for (j = 0; j < E - i - 1; j++)
        {
            if (edges[j].weight > edges[j + 1].weight)
            {
                temp = edges[j];
                edges[j] = edges[j + 1];
                edges[j + 1] = temp;
            }
        }
    }
}

int main()
{
    struct Edge edges[E] =
    {
        {0, 1, 2},
        {0, 3, 6},
        {1, 2, 3},
        {1, 3, 8},
        {1, 4, 5},
        {2, 4, 7},
        {3, 4, 9}
    };

    int i, count = 0, total = 0;

    for (i = 0; i < V; i++)
        parent[i] = i;

    sortEdges(edges);

    printf("Edges in Minimum Spanning Tree:\n");

    for (i = 0; i < E && count < V - 1; i++)
    {
        int u = edges[i].source;
        int v = edges[i].destination;

        if (find(u) != find(v))
        {
            printf("%d - %d : %d\n", u, v, edges[i].weight);

            total += edges[i].weight;
            unionSet(u, v);
            count++;
        }
    }

    printf("Minimum cost = %d\n", total);

    return 0;
}
