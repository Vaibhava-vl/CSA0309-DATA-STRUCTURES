#include <stdio.h>

#define INF 9999
#define V 5

void dijkstra(int graph[V][V], int source)
{
    int distance[V], visited[V];
    int i, j, min, next;

    for (i = 0; i < V; i++)
    {
        distance[i] = INF;
        visited[i] = 0;
    }

    distance[source] = 0;

    for (i = 0; i < V - 1; i++)
    {
        min = INF;
        next = -1;

        for (j = 0; j < V; j++)
        {
            if (!visited[j] && distance[j] < min)
            {
                min = distance[j];
                next = j;
            }
        }

        visited[next] = 1;

        for (j = 0; j < V; j++)
        {
            if (!visited[j] && graph[next][j] != 0 &&
                distance[next] + graph[next][j] < distance[j])
            {
                distance[j] = distance[next] + graph[next][j];
            }
        }
    }

    printf("Shortest distances from vertex %d:\n", source);

    for (i = 0; i < V; i++)
        printf("To vertex %d = %d\n", i, distance[i]);
}

int main()
{
    int graph[V][V] =
    {
        {0, 10, 3, 0, 0},
        {10, 0, 1, 2, 0},
        {3, 1, 0, 8, 2},
        {0, 2, 8, 0, 7},
        {0, 0, 2, 7, 0}
    };

    int source = 0;

    dijkstra(graph, source);

    return 0;
}
