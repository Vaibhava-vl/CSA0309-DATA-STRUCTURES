#include <stdio.h>

#define V 5
#define INF 9999

int main()
{
    int graph[V][V] =
    {
        {0, 2, 0, 6, 0},
        {2, 0, 3, 8, 5},
        {0, 3, 0, 0, 7},
        {6, 8, 0, 0, 9},
        {0, 5, 7, 9, 0}
    };

    int selected[V] = {0};
    int edges = 0;
    int total = 0;
    int i, j, x, y, min;

    selected[0] = 1;

    printf("Edges in Minimum Spanning Tree:\n");

    while (edges < V - 1)
    {
        min = INF;
        x = y = -1;

        for (i = 0; i < V; i++)
        {
            if (selected[i])
            {
                for (j = 0; j < V; j++)
                {
                    if (!selected[j] && graph[i][j] != 0)
                    {
                        if (graph[i][j] < min)
                        {
                            min = graph[i][j];
                            x = i;
                            y = j;
                        }
                    }
                }
            }
        }

        printf("%d - %d : %d\n", x, y, min);

        total += min;
        selected[y] = 1;
        edges++;
    }

    printf("Minimum cost = %d\n", total);

    return 0;
}
