#include <stdio.h>

#define MAX_SIZE 100 // Maximum capacity of the array

// Function prototypes
void display(int arr[], int size);
int insert(int arr[], int *size, int element, int position);
int deleteElement(int arr[], int *size, int position);

int main() {
    int arr[MAX_SIZE];
    int size = 0, choice, element, pos;

    // Initial population of the array
    printf("Enter initial number of elements in array (max %d): ", MAX_SIZE);
    scanf("%d", &size);

    if (size > MAX_SIZE || size < 0) {
        printf("Invalid size! Setting array size to 0.\n");
        size = 0;
    } else {
        printf("Enter %d elements:\n", size);
        for (int i = 0; i < size; i++) {
            printf("Element [%d]: ", i);
            scanf("%d", &arr[i]);
        }
    }

    // Menu-driven interface
    while (1) {
        printf("\n--- ARRAY OPERATIONS MENU ---\n");
        printf("1. Display Array\n");
        printf("2. Insert Element\n");
        printf("3. Delete Element\n");
        printf("4. Exit\n");
        printf("Enter your choice (1-4): ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                display(arr, size);
                break;

            case 2:
                printf("Enter element to insert: ");
                scanf("%d", &element);
                printf("Enter position (0 to %d): ", size);
                scanf("%d", &pos);

                if (insert(arr, &size, element, pos)) {
                    printf("Element %d inserted successfully at position %d.\n", element, pos);
                }
                break;

            case 3:
                if (size == 0) {
                    printf("Array Underflow! Array is empty, nothing to delete.\n");
                    break;
                }
                printf("Enter position to delete (0 to %d): ", size - 1);
                scanf("%d", &pos);

                if (deleteElement(arr, &size, pos)) {
                    printf("Element at position %d deleted successfully.\n", pos);
                }
                break;

            case 4:
                printf("Exiting program.\n");
                return 0;

            default:
                printf("Invalid choice! Please select 1, 2, 3, or 4.\n");
        }
    }

    return 0;
}

// Function to print all elements in the array
void display(int arr[], int size) {
    if (size == 0) {
        printf("Array is empty.\n");
        return;
    }
    printf("Array elements: ");
    for (int i = 0; i < size; i++) {
        printf("[%d]: %d  ", i, arr[i]);
    }
    printf("\n");
}

// Function to insert an element at a given 0-indexed position
int insert(int arr[], int *size, int element, int position) {
    if (*size >= MAX_SIZE) {
        printf("Error: Array Overflow! Cannot insert more elements.\n");
        return 0;
    }
    if (position < 0 || position > *size) {
        printf("Error: Invalid position! Position must be between 0 and %d.\n", *size);
        return 0;
    }

    // Shift elements to the right to make room
    for (int i = *size; i > position; i--) {
        arr[i] = arr[i - 1];
    }

    arr[position] = element;
    (*size)++; // Increase array size
    return 1;
}

// Function to delete an element at a given 0-indexed position
int deleteElement(int arr[], int *size, int position) {
    if (position < 0 || position >= *size) {
        printf("Error: Invalid position! Position must be between 0 and %d.\n", *size - 1);
        return 0;
    }

    // Shift elements to the left to fill the gap
    for (int i = position; i < *size - 1; i++) {
        arr[i] = arr[i + 1];
    }

    (*size)--; // Decrease array size
    return 1;
}
