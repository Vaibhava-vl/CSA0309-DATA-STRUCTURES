#include <stdio.h>

#define SIZE 10

int hashTable[SIZE];

void insert(int key)
{
    int index = key % SIZE;
    int start = index;

    while (hashTable[index] != -1)
    {
        index = (index + 1) % SIZE;

        if (index == start)
        {
            printf("Hash Table is Full\n");
            return;
        }
    }

    hashTable[index] = key;
}

void display()
{
    int i;
    printf("\nIndex\tValue\n");
    for (i = 0; i < SIZE; i++)
    {
        if (hashTable[i] == -1)
            printf("%d\t-\n", i);
        else
            printf("%d\t%d\n", i, hashTable[i]);
    }
}

int main()
{
    int n, key, i;

    for (i = 0; i < SIZE; i++)
        hashTable[i] = -1;

    printf("Enter number of keys: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++)
    {
        printf("Enter key: ");
        scanf("%d", &key);
        insert(key);
    }

    display();

    return 0;
}
