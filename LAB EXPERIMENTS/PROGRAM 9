#include <stdio.h>

// Function to sort array in ascending order (Bubble Sort)
void sortArray(int arr[], int n) {
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (arr[j] > arr[j + 1]) {
                int temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }
}

// Function to perform Binary Search
int binarySearch(int arr[], int size, int key) {
    int low = 0;
    int high = size - 1;

    while (low <= high) {
        int mid = low + (high - low) / 2; // Prevents overflow for large indices

        // Check if key is present at mid
        if (arr[mid] == key) {
            return mid;
        }

        // If key is smaller, ignore right half
        if (arr[mid] > key) {
            high = mid - 1;
        } 
        // If key is larger, ignore left half
        else {
            low = mid + 1;
        }
    }

    // Element was not present
    return -1;
}

int main() {
    int n, key;

    // Get array size
    printf("Enter the number of elements: ");
    scanf("%d", &n);

    int arr[n];

    // Input elements
    printf("Enter %d integers:\n", n);
    for (int i = 0; i < n; i++) {
        printf("Element [%d]: ", i);
        scanf("%d", &arr[i]);
    }

    // Sort the array (Binary Search requires a sorted array)
    sortArray(arr, n);

    printf("\nSorted Array: ");
    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    // Get search key
    printf("Enter the number to search: ");
    scanf("%d", &key);

    // Perform Binary Search
    int result = binarySearch(arr, n, key);

    if (result != -1) {
        printf("Success! Number %d found at index %d in the sorted array.\n", key, result);
    } else {
        printf("Element %d is not present in the array.\n", key);
    }

    return 0;
}
