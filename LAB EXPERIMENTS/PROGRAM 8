#include <stdio.h>

int main() {
    int n, key, found = 0;

    // Get array size from user
    printf("Enter the number of elements in the array: ");
    scanf("%d", &n);

    int arr[n];

    // Input array elements
    printf("Enter %d elements:\n", n);
    for (int i = 0; i < n; i++) {
        printf("Element [%d]: ", i);
        scanf("%d", &arr[i]);
    }

    // Get the search key
    printf("\nEnter the number to search: ");
    scanf("%d", &key);

    // Perform Linear Search
    for (int i = 0; i < n; i++) {
        if (arr[i] == key) {
            printf("\nSuccess! Number %d found at index %d (Position %d).\n", key, i, i + 1);
            found = 1;
            break; // Stop searching once found
        }
    }

    // If element was not found in the array
    if (!found) {
        printf("\nElement %d is not present in the array.\n", key);
    }

    return 0;
}
